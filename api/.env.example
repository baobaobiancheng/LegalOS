# MySQL 数据库连接
DATABASE_URL="mysql://root:yourpassword@localhost:3306/legal_platform"

# JWT 密钥（生产环境务必更换为随机字符串）
JWT_SECRET="change-me-to-a-random-string-in-production"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_MS="86400000"

# 服务端口
PORT="3000"

# 前端 Vite dev server 地址（CORS 白名单）
WEB_ORIGIN="http://localhost:5173"

# ==== CAS 统一登录（2026-08-10）====
# CAS 服务地址（方式一登录：POST {CAS_HOST}/api/login 换 ticket；validate：GET /validate?ticket=）
CAS_HOST="https://cas-pre.100credit.cn"
# CAS 项目 code（CAS 后台注册；方式一登录必须传）
CAS_PROJECT_CODE="legalos"
# 方式一登录的 redirectUrl（登录成功跳转地址，固定填前端登录页即可）
CAS_REDIRECT_URL="http://192.168.162.170:5173/login"
# CAS 账号→角色 个人映射（'账号:role,账号2:role2'；优先级最高；role ∈ admin/legal_bp/legal_lead/business）
# 示例：法务管理员赵俊芳 → legal_lead；其余人按部门/默认
CAS_ROLE_MAP="junfang.zhao:legal_lead"
# 部门→角色 映射（用户决策 A：按【钉钉同步的 User.department】匹配，非 CAS deptName；'法务部:legal_bp,部门2:role2'）
CAS_DEPT_MAP="法务部:legal_bp"
# 本地 CAS 流程调试用 Mock（仅非生产；生产/预发(CAS_ENFORCED)禁止，启动 fail-fast）
CAS_BYPASS="false"
# CAS 强制环境（预发/生产设 true：密码登录 403、password 会话拒绝、缺 CAS_HOST 启动失败）
CAS_ENFORCED="false"
# CAS 调用超时（毫秒）
CAS_VALIDATE_TIMEOUT_MS="5000"
# 会话链绝对上限（毫秒，默认 7 天；refresh 旋转不超此限，防无限存活）
SESSION_CAP_MS="604800000"

# 种子用户密码（生产环境请通过环境变量注入，勿写死在代码中）
SEED_ADMIN_PASSWORD="admin123"
SEED_LEGAL_BP_PASSWORD="legal123"
SEED_LEGAL_LEAD_PASSWORD="legal123"
SEED_BUSINESS_PASSWORD="biz123"

# 钉钉企业内部应用（2026-08-05 钉钉拉群；真实凭证只放 .env，勿提交）
DINGTALK_APP_KEY=""
DINGTALK_APP_SECRET=""
DINGTALK_AGENT_ID=""
DINGTALK_ROBOT_CODE=""
# 场景群群模板 ID（创建普通群v2 有组织 1000 建群配额，达上限需用无上限的场景群）
DINGTALK_SCENE_TEMPLATE_ID=""
# true = 使用 Mock 适配器（无凭证本地开发）；false/缺省 = 真实钉钉
DINGTALK_MOCK="true"

# ==== Codex 安全加固（2026-08-09 P0-01） ====
# AI Kill Switch：false / 0 / off 时拦截所有 codex 调用（登录/工单/人工流程不受影响）
AI_EXECUTION_ENABLED="true"
# 服务器硬化模式：true = 严格配置 + 环境白名单 + 认证走公司网关（生产服务器设置 true；本地开发保持 false）
CODEX_HARDENED="false"
# codex 认证密钥（公司大模型网关 token；由受管配置 env_key 读取，勿用真实 .env 值提交）
CODEX_API_KEY=""

# ==== Codex 并发队列（2026-08-09 P1-02）====
# 全局同时运行的 Codex 子进程上限（保守默认 4；生产值由压测确认，不再默认 50）
CODEX_CONCURRENCY=4
# 排队上限：队列满时返回"AI 服务繁忙"错误，不启动子进程
CODEX_QUEUE_MAX_SIZE=100
# 排队超时（毫秒）：排队超时不启动子进程
CODEX_QUEUE_TIMEOUT_MS=120000
# 同一 sessionId/projectId 同时最多运行任务数（=1 保证同工单 AI 严格串行）
CODEX_PROJECT_CONCURRENCY=1

# ==== 咨询直连网关（2026-08-12 多轮会话上下文改造）====
# 法律咨询直接调用公司大模型网关 /v1/chat/completions（不再经 Codex app-server）
LLM_BASE_URL="http://api-cybotforge-pre.brapp.com/v1"
# 共享 key：LLM_API_KEY 优先，缺省回退 CODEX_API_KEY（见《服务器项目接入大模型网关说明》）
LLM_API_KEY=""
LLM_MODEL="glm-5-2"
# 输出 token 预算 = 思考 + 答案合计（契约 C8：思考会吃预算致 content=null）。
# 分级（review 2026-08-12 第5轮）：普通 P2 咨询 3000，减少冗长回答与流式时长；
# 复杂/长文研究 6000~12000；硬上限 16000（glm-5-2 最大输出）。
# 不把所有场景都拉到 16000——一旦模型循环重复，长预算会重复更多。
CONSULT_P2_OUTPUT_TOKENS="3000"
CONSULT_COMPLEX_OUTPUT_TOKENS="6000"
CONSULT_OUTPUT_TOKEN_RESERVE="16000"
# 生成超时（毫秒）：16000 token 生成需数分钟，默认 10 分钟
CONSULT_CHAT_TIMEOUT_MS="600000"
# 上下文最近完整问答对数（q/a 不拆对）
CONSULT_RECENT_TURNS="6"
# 输入上下文窗口上限（阶段1 保守默认；glm-5-2 实际窗口待校准）
CONSULT_CONTEXT_MAX_TOKENS="12000"
# ConsultationRun 卡死判定（毫秒）：running 超过该时长视为卡死，重置重跑
CONSULT_RUN_STALE_MS="600000"

# ==== Outbox Worker（2026-08-09 P1-04）====
# 轮询间隔（毫秒）
OUTBOX_POLL_INTERVAL_MS=1000
# 任务租约（毫秒）：租约过期后其他实例可回收认领
OUTBOX_LEASE_MS=60000
# 最大重试次数：超过进入 dead
OUTBOX_MAX_ATTEMPTS=8
# 单批认领数量
OUTBOX_BATCH_SIZE=10
