# MySQL 数据库连接
DATABASE_URL="mysql://root:yourpassword@localhost:3306/legal_platform"

# JWT 密钥（生产环境务必更换为随机字符串）
JWT_SECRET="change-me-to-a-random-string-in-production"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_MS="86400000"

# 服务端口
PORT="3000"

# 前端 Vite dev server 地址（CORS 白名单）
WEB_ORIGIN="http://localhost:5173"

# 种子用户密码（生产环境请通过环境变量注入，勿写死在代码中）
SEED_ADMIN_PASSWORD="admin123"
SEED_LEGAL_BP_PASSWORD="legal123"
SEED_LEGAL_LEAD_PASSWORD="legal123"
SEED_BUSINESS_PASSWORD="biz123"

# 钉钉企业内部应用（2026-08-05 钉钉拉群；真实凭证只放 .env，勿提交）
DINGTALK_APP_KEY=""
DINGTALK_APP_SECRET=""
DINGTALK_AGENT_ID=""
DINGTALK_ROBOT_CODE=""
# true = 使用 Mock 适配器（无凭证本地开发）；false/缺省 = 真实钉钉
DINGTALK_MOCK="true"
