{
  "name": "legal-platform-api",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test": "vitest run",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit --experimentalDecorators --module commonjs --target es2022 --esModuleInterop --skipLibCheck scripts/verify-dsh-model.ts scripts/verify-dsh-baijian-agent.ts",
    "test:unit": "vitest run --exclude \"test/**/*.integration.spec.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "codex:baijian-preflight": "ts-node scripts/preflight-codex-baijian.ts",
    "baijian:verify": "ts-node scripts/verify-baijian-mcp.ts",
    "codex:baijian-gate": "ts-node scripts/verify-codex-baijian-agent.ts",
    "dsh:runtime-gate": "node scripts/verify-dsh-runtime.cjs",
    "dsh:model-gate": "ts-node scripts/verify-dsh-model.ts",
    "dsh:baijian-gate": "ts-node scripts/verify-dsh-baijian-agent.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
