generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  legal_bp
  legal_lead
  business
  admin
}

enum ProjectKind {
  consult
  contract
  research
  draft
}

enum ProjectStatus {
  分析中
  待处理
  待复核
  已回传
  已取消
}

enum RiskLevel {
  P0
  P1
  P2
}

enum SkillVisibility {
  private // 私有：仅创建者可见可用
  pending // 待审核：已提交为公有，审核中
  public // 公有：全员可见可用
}

enum OutboxStatus {
  pending
  processing
  succeeded
  dead
}

enum ContractDocumentType {
  draft
  revised
  final
}

enum ContractReviewStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum ContractGenerationStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum ContactSyncStatus {
  running
  complete
  failed
}

enum SkillReviewAction {
  submit
  withdraw
  approve
  reject
  archive
  restore
}

model User {
  id             String    @id @default(uuid())
  username       String    @unique
  passwordHash   String    @map("password_hash")
  displayName    String    @map("display_name")
  role           Role
  isActive       Boolean   @default(true) @map("is_active")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")

  // 钉钉绑定（2026-08-05 钉钉拉群）：通讯录同步写入，建群直接传 userid
  // @unique（P1-07）：一个系统用户最多绑一个钉钉联系人，重名不会自动错绑
  dingtalkUserId String? @unique @map("dingtalk_user_id") @db.VarChar(128)
  dingtalkPhone  String? @map("dingtalk_phone") @db.VarChar(32)

  // CAS 绑定（2026-08-10 CAS 统一登录）：@unique 一个系统用户最多绑一个公司 CAS 账号；
  // CAS 是唯一身份来源(生产),cas-login 按 casUsername 找/建,防重复人
  casUsername String? @unique @map("cas_username") @db.VarChar(128)
  // 组织架构部门（2026-08-11 统一身份映射）：CAS 登录写入(deptName)/钉钉绑定同步;角色 CAS_DEPT_MAP 据此匹配
  department String? @map("department") @db.VarChar(128)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  loginAudits     LoginAudit[]
  refreshTokens   RefreshToken[]
  createdProjects Project[]      @relation("CreatedProjects")
  ownedProjects   Project[]      @relation("OwnedProjects")
  legalBpProjects Project[]      @relation("LegalBpProjects")
  contractFiles   ContractFile[]
  createdSkills   Skill[]        @relation("CreatedSkills")
  approvedSkills  Skill[]        @relation("ApprovedSkills")
  bpDomainMaps    BpDomainMap[]

  @@map("users")
}

// 法务 BP 领域映射（2026-08-05 钉钉拉群）：BP 工作范围 → 6 领域白名单（SKILL_GROUPS 同源）
// 意图识别/技能 group 出领域 → 查此表匹配 BP → 指派 legalBpId → 拉群
model BpDomainMap {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  domain    String   @db.VarChar(64) // 合规法务/合同与交易/劳动法务/争议法务/法律研究/知识运营
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, domain])
  @@index([domain])
  @@map("bp_domain_maps")
}

// 钉钉通讯录快照（2026-08-05）：同步结果落库，手动绑定可在快照内搜索
// P1-07：不再硬删除，完整同步成功后缺失联系人仅软失效（isActive=false），失败批次不动旧快照
model DingTalkContact {
  id              String   @id @default(uuid())
  userId          String   @map("user_id") // 钉钉 userid
  name            String   @db.VarChar(128)
  mobile          String?  @db.VarChar(32)
  // 部门（2026-08-11 手动绑定路径也带部门,review 修复）
  department      String?  @db.VarChar(128)
  isActive        Boolean  @default(true) @map("is_active")
  lastSeenBatchId String?  @map("last_seen_batch_id") @db.VarChar(64)
  lastSeenAt      DateTime @default(now()) @map("last_seen_at")
  syncedAt        DateTime @default(now()) @map("synced_at")

  @@unique([userId])
  @@index([name])
  @@map("dingtalk_contacts")
}

// 同步批次（P1-07/P1-08）：记录每次全量同步的完整性状态；仅 complete 批次允许失效对账/自动绑定
model DingTalkSyncBatch {
  id              String            @id @default(uuid())
  status          ContactSyncStatus @default(running)
  contactCount    Int               @default(0) @map("contact_count")
  autoBoundCount  Int               @default(0) @map("auto_bound_count")
  departmentCount Int               @default(0) @map("department_count")
  truncated       Boolean           @default(false)
  errorMessage    String?           @map("error_message") @db.Text
  startedAt       DateTime          @default(now()) @map("started_at")
  completedAt     DateTime?         @map("completed_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  staging DingTalkContactStaging[]

  @@index([status, startedAt])
  @@map("dingtalk_sync_batches")
}

// 同步 staging（P1-08）：批内数据先 createMany 落 staging，完整校验通过后短事务 merge 到正式表
model DingTalkContactStaging {
  id      String            @id @default(uuid())
  batchId String            @map("batch_id")
  batch   DingTalkSyncBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  userId  String            @map("user_id") @db.VarChar(128)
  name    String            @db.VarChar(128)
  mobile  String?           @db.VarChar(32)
  // 部门名（2026-08-11 组织架构身份映射）：钉钉同步按部门拉取时写入
  department String?        @db.VarChar(128)

  @@unique([batchId, userId])
  @@index([batchId, name])
  @@map("dingtalk_contact_staging")
}

model Project {
  id             String        @id @default(uuid())
  // 幂等键（P1-03）：客户端/CRM 提供，同一键只创建一个工单，防重试重复建单/建群
  idempotencyKey String?       @unique @map("idempotency_key")
  kind           ProjectKind
  title          String        @db.VarChar(256)
  status         ProjectStatus @default(分析中)
  risk           RiskLevel     @default(P2)
  route          String        @default("legalbp") @db.VarChar(32) // llm | legalbp
  isFailed       Boolean       @default(false) @map("is_failed")
  skillId        String?       @map("skill_id") @db.VarChar(64)
  skillName      String?       @map("skill_name") @db.VarChar(128)
  model          String?       @db.VarChar(128)
  deliveryMode   String?       @map("delivery_mode") @db.VarChar(32)
  result         String?       @db.Text

  // 创建者 & 处理人
  creator   User    @relation("CreatedProjects", fields: [creatorId], references: [id])
  creatorId String  @map("creator_id")
  owner     User    @relation("OwnedProjects", fields: [ownerId], references: [id])
  ownerId   String  @map("owner_id")
  legalBp   User?   @relation("LegalBpProjects", fields: [legalBpId], references: [id])
  legalBpId String? @map("legal_bp_id")

  // 提出人信息
  requesterName       String? @map("requester_name") @db.VarChar(128)
  requesterDepartment String? @map("requester_department") @db.VarChar(128)

  // CRM 上下文（Adapter 占位）
  crmReference   String? @map("crm_reference") @db.VarChar(256)
  crmCustomer    String? @map("crm_customer") @db.VarChar(256)
  crmOpportunity String? @map("crm_opportunity") @db.VarChar(256)

  // 钉钉（Adapter 占位）
  dingtalkChatId  String? @map("dingtalk_chat_id") @db.VarChar(256)
  dingtalkMembers String? @map("dingtalk_members") @db.VarChar(1024)

  // 周报预留
  weeklyReportLabel String? @map("weekly_report_label") @db.VarChar(128)

  // 合同模板溯源（合同协作模块）
  contractTemplateSlug String? @map("contract_template_slug") @db.VarChar(64)

  // 类型特有扩展字段（2026-08-03 架构决策）：research/draft 等新类型的冷字段进 JSON，
  // 避免每类型加列导致表膨胀。频繁过滤的字段仍用独立列。
  extra Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages          ProjectMessage[]
  events            ProjectEvent[]
  files             ContractFile[]
  outboxEvents      OutboxEvent[]
  contractDocuments ContractDocument[]
  reviewRuns        ContractReviewRun[]
  generationRuns    ContractGenerationRun[]

  @@index([creatorId])
  @@index([ownerId])
  @@index([status])
  @@index([kind])
  @@map("projects")
}

model ProjectMessage {
  id        String   @id @default(uuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String   @map("project_id")
  role      String   @db.VarChar(32) // user | assistant | legal | event
  text      String   @db.Text
  label     String?  @db.VarChar(256)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@map("project_messages")
}

model ProjectEvent {
  id        String   @id @default(uuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String   @map("project_id")
  text      String   @db.Text // "14:32 · 工单已创建并通知法务BP"
  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@map("project_events")
}

// 合同模板（3 个内置模板种子数据；P1 模板管理直接复用此表）
model ContractTemplate {
  id          String  @id @default(uuid())
  slug        String  @unique @db.VarChar(64) // ai-service | nda-institution | tech-dev
  name        String  @db.VarChar(128) // 百融AI服务协议 | 保密协议V4.5 | 技术开发合同
  category    String  @db.VarChar(32) // AI服务 | 保密 | 技术开发
  description String? @db.VarChar(512) // 适用场景说明
  prompt      String  @db.Text // 生成 prompt 模板（章节框架 + 要素占位符）

  // 模板升级（2026-08-03）：每模板独立导出样式 + 要素表单 + 源文件
  style          Json? // 导出样式参数（字体/字号/标题/页边距/行距，每模板独立）
  elementsSchema Json? // 合同要素表单 schema（字段定义数组，前端动态渲染）
  sourceFile     String? @map("source_file") @db.VarChar(256) // 模板源文件（storage/contract-templates/{slug}/ 内）

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contract_templates")
}

// 技能库（2026-08-04 技能库模块）
// 状态机：private →(submit)→ pending →(approve)→ public；pending →(reject/withdraw)→ private
// 审核记录 append-only：reviewLog Json 数组 [{ action: 'approve'|'reject', reviewerId, reason?, at }]
// （驳回历史不覆盖丢失，工程评审决策 OV#2；reviewReason 单字段已由 reviewLog 替代）
model Skill {
  id          String          @id @default(uuid())
  slug        String          @unique @db.VarChar(64) // 技能代号，创建后不可变（保留字：general + seed slug 禁注册）
  name        String          @db.VarChar(128)
  group       String          @db.VarChar(64) // 6 组白名单：合规法务/合同与交易/劳动法务/争议法务/法律研究/知识运营
  description String          @db.Text
  prompt      String          @db.Text // system prompt，≤4000 字（DTO 校验）
  visibility  SkillVisibility @default(private)
  isActive    Boolean         @default(true) // 停用后不可选用（历史工单快照不受影响）
  creatorId   String
  approvedBy  String? // 最近一次审核通过人
  approvedAt  DateTime?
  reviewLog   Json            @default("[]") // append-only 审核记录（含全部驳回原因）
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  creator  User  @relation("CreatedSkills", fields: [creatorId], references: [id], onDelete: Restrict)
  approver User? @relation("ApprovedSkills", fields: [approvedBy], references: [id], onDelete: SetNull)

  reviewLogs SkillReviewLog[]

  @@index([visibility])
  @@index([group])
  @@map("skills")
}

// 技能审核审计日志（P1-09）：规范化、append-only、事务内写入。旧 reviewLog Json 字段保留做兼容迁移。
model SkillReviewLog {
  id        String            @id @default(uuid())
  eventId   String            @unique @map("event_id") @db.VarChar(64)
  skillId   String            @map("skill_id")
  skill     Skill             @relation(fields: [skillId], references: [id], onDelete: Restrict)
  action    SkillReviewAction
  fromState String            @map("from_state") @db.VarChar(32)
  toState   String            @map("to_state") @db.VarChar(32)
  actorId   String            @map("actor_id")
  reason    String?           @db.Text
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([skillId, createdAt])
  @@index([actorId, createdAt])
  @@map("skill_review_logs")
}

// 风险分类审计（P1-11）：记录最终风险、规则命中、模型结果与版本，不含完整咨询正文
model RiskAssessmentLog {
  id                String   @id @default(uuid())
  projectId         String   @map("project_id")
  finalRisk         String   @map("final_risk") @db.VarChar(8)
  route             String   @db.VarChar(16)
  domain            String?  @db.VarChar(64)
  ruleFloor         String?  @map("rule_floor") @db.VarChar(8)
  matchedRuleIds    Json     @default("[]") @map("matched_rule_ids")
  modelRisk         String?  @map("model_risk") @db.VarChar(8)
  modelReason       String?  @map("model_reason") @db.Text
  classifierVersion String   @map("classifier_version") @db.VarChar(32)
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@map("risk_assessment_logs")
}

// 合同附件（本地磁盘文件，DB 只存元数据）
// kind 仅 revised | final：草稿走前端 markdown→docx（DownloadMenu），不落盘
model ContractFile {
  id           String   @id @default(uuid())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String   @map("project_id")
  kind         String   @db.VarChar(32) // revised | final
  originalName String   @map("original_name") @db.VarChar(256)
  storedName   String   @map("stored_name") @db.VarChar(256) // uuid.ext，磁盘文件名
  mimeType     String?  @map("mime_type") @db.VarChar(128)
  size         Int
  uploadedBy   String   @map("uploaded_by") // FK → users.id
  uploader     User     @relation(fields: [uploadedBy], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@map("contract_files")
}

model RefreshToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  jti       String   @unique
  tokenHash String   @map("token_hash")
  isUsed    Boolean  @default(false) @map("is_used")
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")

  // CAS 会话上限（2026-08-10 T6）：authMethod=password|cas；originalExpiresAt 绝对过期,
  // 旋转时携带,链寿命封顶(防 refresh 无限旋转存活)
  authMethod        String    @default("password") @map("auth_method") @db.VarChar(16)
  originalExpiresAt DateTime? @map("original_expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([jti])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model LoginAudit {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @map("user_id")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("login_audits")
}

// 事务 Outbox（P1-03/P1-04）：工单创建等本地事务成功后，外部副作用（钉钉建群/加人/消息）以事件入队，
// 由 OutboxWorker 异步带租约消费。dedupKey 保证重试幂等；lease 保证崩溃后任务可被回收。
model OutboxEvent {
  id            String       @id @default(uuid())
  eventType     String       @map("event_type") @db.VarChar(64)
  aggregateType String       @map("aggregate_type") @db.VarChar(64)
  aggregateId   String       @map("aggregate_id")
  dedupKey      String       @unique @map("dedup_key") @db.VarChar(191)
  payload       Json
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at")
  claimedAt     DateTime?    @map("claimed_at")
  claimToken    String?      @map("claim_token") @db.VarChar(64)
  lastError     String?      @map("last_error") @db.Text
  completedAt   DateTime?    @map("completed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([aggregateId])
  @@index([projectId])
  @@map("outbox_events")
}

// 合同文档版本（P1-05）：合同正文以独立领域模型保存，审查显式绑定 sourceDocumentId，
// 不再从 ProjectMessage 按 role/label 推断。风险报告永远只进 ContractReviewRun.result。
model ContractDocument {
  id           String               @id @default(uuid())
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String               @map("project_id")
  documentType ContractDocumentType @map("document_type")
  version      Int
  content      String               @db.LongText
  sourceFileId String?              @map("source_file_id") @db.VarChar(64)
  createdBy    String?              @map("created_by") @db.VarChar(64)
  createdAt    DateTime             @default(now()) @map("created_at")

  reviewRuns     ContractReviewRun[]
  generationRuns ContractGenerationRun[]

  @@unique([projectId, version])
  @@index([projectId, documentType, createdAt])
  @@map("contract_documents")
}

// 合同生成运行（P1-03）：把“是否已经启动/完成一条生成流”从 Project 状态中独立出来。
// requestKey 唯一约束保护同一请求的并发重试；不同 requestKey 可以安全竞争新版本。
model ContractGenerationRun {
  id           String                   @id @default(uuid())
  projectId    String                   @map("project_id")
  project      Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestKey   String                   @unique @map("request_key") @db.VarChar(191)
  templateSlug String                   @map("template_slug") @db.VarChar(64)
  elementsHash String                   @map("elements_hash") @db.VarChar(64)
  status       ContractGenerationStatus @default(queued)
  documentId   String?                  @unique @map("document_id")
  document     ContractDocument?        @relation(fields: [documentId], references: [id], onDelete: SetNull)
  errorMessage String?                  @map("error_message") @db.Text
  startedAt    DateTime?                @map("started_at")
  completedAt  DateTime?                @map("completed_at")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  @@index([projectId, createdAt])
  @@index([projectId, status])
  @@map("contract_generation_runs")
}

// 审查运行（P1-05）：每次审查创建一条 run，记录源文档、状态、结果与错误。
model ContractReviewRun {
  id               String               @id @default(uuid())
  projectId        String               @map("project_id")
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceDocumentId String               @map("source_document_id")
  sourceDocument   ContractDocument     @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  status           ContractReviewStatus @default(queued)
  result           String?              @db.LongText
  skillId          String?              @map("skill_id") @db.VarChar(64)
  errorMessage     String?              @map("error_message") @db.Text
  startedAt        DateTime?            @map("started_at")
  completedAt      DateTime?            @map("completed_at")
  createdBy        String               @map("created_by") @db.VarChar(64)
  createdAt        DateTime             @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@index([sourceDocumentId])
  @@map("contract_review_runs")
}
