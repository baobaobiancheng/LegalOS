{
  "tools": [
    {
      "name": "lawstar_data_professional_query",
      "description": "Sanitized law metadata search fixture",
      "inputSchema": {
        "type": "object",
        "required": ["page", "rows", "keyword"],
        "properties": {
          "page": { "type": "integer" },
          "rows": { "type": "integer" },
          "keyword": { "type": "string" }
        }
      }
    },
    {
      "name": "lawstar_data_professional_detail",
      "description": "Sanitized law detail fixture",
      "inputSchema": {
        "type": "object",
        "required": ["rjs8"],
        "properties": {
          "rjs8": { "type": "string" }
        }
      }
    },
    {
      "name": "lawstar_data_k_query",
      "description": "Sanitized advanced law search fixture",
      "inputSchema": { "type": "object", "required": ["keywords"], "properties": { "keywords": { "type": "string" } } }
    },
    {
      "name": "lawstar_data_xl_query",
      "description": "Sanitized semantic law search fixture",
      "inputSchema": { "type": "object", "properties": { "vector": { "type": "string" }, "keyword": { "type": "string" } } }
    },
    {
      "name": "ldh_search",
      "description": "Sanitized similar-case search fixture",
      "inputSchema": {
        "type": "object",
        "required": ["query", "namespace"],
        "properties": {
          "query": { "type": "string" },
          "namespace": { "type": "string" },
          "top_k": { "type": "integer" }
        }
      }
    }
  ]
}
